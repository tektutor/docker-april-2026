[25.221536, "o", "const express = require('express');\r\nconst mysql = require('mysql2');\r\nconst app = express();\r\n\r\n// 1. Create a connection pool\r\nconst pool = mysql.createPool({\r\n  host: 'localhost',\r\n  user: 'root',      // Replace with your MySQL username\r\n  password: 'password', // Replace with your MySQL password\r\n  database: 'testdb',\r\n  waitForConnections: true,\r\n  connectionLimit: 10,\r\n  queueLimit: 0\r\n});\r\n\r\n// 2. Define the route to fetch and display data\r\napp.get('/', (req, res) => {\r\n  pool.query('SELECT * FROM users', (err, results) => {\r\n    if (err) {\r\n      return res.status(500).send('Database error: ' + err.message);\r\n    }\r\n\r\n    // 3. Build a simple HTML table to show in the browser\r\n    let html = '<h1>User List</h1><table border=\"1\"><tr><th>ID</th><th>Name</th><th>Email</th></tr>';\r\n    \r\n    results.forEach(user => {\r\n      html += `<tr>\r\n                <td>${user.id}</td>\r\n                <td>${user.name}</td>\r\n                <td>${user.email}</td>\r\n              </tr>`;\r\n    });\r\n\r\n    html += '</table>';\r\n    res.send(html);\r\n  });\r\n});\r\n\r\napp.listen(3000, () => {\r\n  console.log('Server running at http://localhost:3000');\r\n});\r\n"]
