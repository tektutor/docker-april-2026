[35.196561, "o", "                                                                                          \r\n                                                                                                                                                   \r\n                                                                                                                                                   \r\n                                                                                                                                                   \r\n                                                                                                                                                   \r\n                                                                                                                                                   \r\n                                                                                                                                                   \r\n                                                                                                                                                   \r\n                                                                                                                                                   \r\n                                                                                                                                                   \u001b[H\u001b(B\u001b[0;1m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27mconst\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m express = require(\u001b(B\u001b[m\u001b[38;2;179;246;192m\u001b[48;2;20;22;27m'express'\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m);\u001b[K\r\n\u001b(B\u001b[0;1m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27mconst\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m mysql = require(\u001b(B\u001b[m\u001b[38;2;179;246;192m\u001b[48;2;20;22;27m'mysql2'\u001b(B\u001b[